{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.js": { "runtime": "nodejs20.x", "maxDuration": 15 } },
  "rewrites": [
    { "source": "/checkout", "destination": "/checkout.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/azucar-en-equilibrio/", "permanent": false }
  ]
}
