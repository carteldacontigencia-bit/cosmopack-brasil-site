# ─── XPag ───────────────────────────────────────────────────────────
# Dashboard XPag → API. El secreto NUNCA va al HTML ni al front.
XPAG_CLIENT_ID=
XPAG_CLIENT_SECRET=
# 1 = sandbox (credenciales públicas de XPag, no mueve dinero).
# Quitar en producción.
XPAG_SANDBOX=1

# ─── Este sitio ─────────────────────────────────────────────────────
# Dominio público. Sirve para la allowlist de origen y para armar la URL
# del webhook que se le manda a XPag.
PUBLIC_URL=https://tu-proyecto.vercel.app
SITE_ORIGIN=https://tu-proyecto.vercel.app

# Secreto propio que firma los enlaces de acceso. Generar con:
#   openssl rand -base64 48
# Si cambia, los enlaces ya entregados dejan de abrir.
ACCESS_SECRET=

# Secreto que va en la URL del webhook. Generar igual que el anterior.
WEBHOOK_KEY=

# ─── Producto ───────────────────────────────────────────────────────
# El nombre con el que te conoce el comprador. Se compara con el
# beneficiario que devuelve XPag: si no coinciden, la pantalla lo
# explica, que es el principal motivo de abandono en México.
BRAND_NAME=

# Página con los PDFs. Debe tener una ruta ALEATORIA y noindex: el
# redirect verifica el pago, pero no puede impedir que alguien comparta
# la URL final una vez que la tiene.
PRODUCT_URL=https://tu-proyecto.vercel.app/gracias-e41b9fb5ec65061a.html

# Horas de validez que se muestran en pantalla. La documentación de XPag
# no expone vencimiento para MXN, así que este plazo es una política
# tuya, no un dato del gateway.
REF_HOURS=24

# ─── Meta ───────────────────────────────────────────────────────────
# El Pixel ID es público por naturaleza (va en el HTML de cualquier
# sitio). Sin él no se carga el script de Meta, y los eventos de checkout
# sólo se disparan para quien viene de anuncio.
META_PIXEL_ID=4479089439026636

# Token de la Conversions API: Events Manager → Configuración → Generar
# token de acceso. ESTE SÍ ES SECRETO.
# Sin él, el Purchase sólo se dispara desde el navegador, y entonces las
# ventas por OXXO —que confirman horas después, con la persona lejos de
# la pantalla— nunca llegan a Meta.
META_CAPI_TOKEN=

# Opcional: código de prueba de Events Manager. Deja ver los eventos en
# vivo sin ensuciar las métricas. Quitar cuando termines de probar.
META_TEST_EVENT_CODE=

# ─── Ajustes finos ──────────────────────────────────────────────────
# Cobranzas por minuto y por IP. Holgado a propósito: en México muchas
# personas comparten IP de operadora móvil (NAT).
RATE_CREATE=30
